{
  "name": "serp-apps-pass-integration-proof",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "db:reset": "tsx scripts/db/reset.ts",
    "db:migrate": "wrangler d1 migrations apply apps-pass-integration-proof --local --persist-to .wrangler/state",
    "operator:serve": "wrangler dev --local --port 8787 --persist-to .wrangler/state",
    "operator:import-app": "tsx scripts/operator/import-app.ts",
    "operator:state": "tsx scripts/operator/state.ts",
    "phase1:test": "tsx --test --test-concurrency=1 tests/phase1.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260813.1",
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "wrangler": "4.122.0"
  }
}
