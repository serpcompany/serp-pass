{
  "name": "serp-apps-pass",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "mvp:dev": "pnpm --filter @serp-apps-pass/web dev",
    "mvp:build": "pnpm --filter @serp-apps-pass/web build",
    "mvp:preview": "pnpm --filter @serp-apps-pass/web preview",
    "mvp:typecheck": "pnpm --filter @serp-apps-pass/web typecheck",
    "mvp:cf-typegen": "pnpm --filter @serp-apps-pass/web cf-typegen",
    "mvp:db:migrate": "pnpm --filter @serp-apps-pass/web db:migrate:local",
    "mvp:operator:bootstrap": "tsx apps/web/scripts/operator/bootstrap-operator.ts",
    "mvp:contracts:test": "pnpm --filter @serp-apps-pass/contracts test",
    "mvp:publisher:test": "pnpm --filter @serp-apps-pass/web test:operator-bootstrap",
    "mvp:billing:test": "pnpm --filter @serp-apps-pass/web test:billing-projection",
    "mvp:stripe-adapter:test": "pnpm --filter @serp-apps-pass/web test:stripe-account-guard && pnpm --filter @serp-apps-pass/web test:stripe-webhook",
    "mvp:extension:build": "pnpm --filter @serp-apps-pass/invited-publisher-extension build",
    "mvp:extension:test": "pnpm --filter @serp-apps-pass/invited-publisher-extension test:browser",
    "mvp:extension:test-staging": "pnpm --filter @serp-apps-pass/invited-publisher-extension test:staging-inclusion",
    "db:reset": "tsx scripts/db/reset.ts",
    "db:migrate": "wrangler d1 migrations apply apps-pass-integration-proof --local --persist-to .wrangler/state",
    "extensions:build": "tsx scripts/extensions/build.ts",
    "operator:serve": "wrangler dev --local --port 8787 --persist-to .wrangler/state",
    "operator:import-app": "tsx scripts/operator/import-app.ts",
    "operator:activate-local-subscription": "tsx scripts/operator/activate-local-subscription.ts",
    "operator:approve-link": "tsx scripts/operator/approve-link.ts",
    "operator:expire-link": "tsx scripts/operator/expire-link.ts",
    "operator:prototype-state": "tsx scripts/operator/prototype-state.ts",
    "operator:revoke-session": "tsx scripts/operator/revoke-session.ts",
    "operator:set-app-status": "tsx scripts/operator/set-app-status.ts",
    "operator:state": "tsx scripts/operator/state.ts",
    "proof:import": "tsx --test --test-concurrency=1 tests/import-contract.proof.test.ts",
    "proof:entitlements": "tsx --test --test-concurrency=1 tests/entitlement-flow.proof.test.ts",
    "proof:browser": "tsx scripts/proof/browser-acceptance.ts",
    "proof:test": "tsx --test --test-concurrency=1 --test-reporter=spec tests/*.proof.test.ts",
    "typecheck": "tsc --noEmit",
    "dev:browser": "node scripts/extension-dev-browser.mjs start",
    "dev:browser:status": "node scripts/extension-dev-browser.mjs status",
    "dev:browser:open": "node scripts/extension-dev-browser.mjs open",
    "dev:browser:logs": "node scripts/extension-dev-browser.mjs logs",
    "dev:browser:stop": "node scripts/extension-dev-browser.mjs stop"
  },
  "dependencies": {
    "@serp-apps-pass/sdk": "workspace:*",
    "ajv": "8.20.0",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260813.1",
    "@types/node": "26.2.0",
    "esbuild": "0.28.2",
    "playwright": "1.62.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "wrangler": "4.122.0"
  }
}
