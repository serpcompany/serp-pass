{
  "buildCommand": ["pnpm", "extensions:build"],
  "buildEnvironment": {
    "EXTENSION_DEV_BROWSER": "1"
  },
  "extensionDiscoveryRoot": "examples",
  "watch": ["examples", "prototype/extension-shell", "packages/app-pass-sdk/src"],
  "previewPath": null,
  "refreshHttpTabs": true,
  "debounceMilliseconds": 250,
  "headless": true,
  "headlessEnvironmentVariable": "EXTENSION_DEV_HEADLESS"
}
